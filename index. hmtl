  <style>
    :root {
      --bg: #08111f; --panel: #0d1a2b; --panel2: #102239;
      --text: #edf5ff; --muted: #91a5bd; --line: rgba(160,190,220,.15);
      --cyan: #45d6d0; --blue: #5b9cff; --white: #fff;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: Manrope, sans-serif; line-height: 1.65; }
    a { color: inherit; text-decoration: none; }
    .container { width: min(1120px, calc(100% - 44px)); margin: auto; }
    .nav-wrap { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(18px); background: rgba(8,17,31,.82); border-bottom: 1px solid var(--line); }
    nav { height: 76px; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; align-items: center; gap: 11px; font-weight: 800; letter-spacing: -.04em; }
    .brand-mark { width: 34px; height: 34px; border: 1px solid rgba(69,214,208,.55); border-radius: 10px; display: grid; place-items: center; color: var(--cyan); font-family: "DM Mono", monospace; font-size: 13px; box-shadow: 0 0 24px rgba(69,214,208,.12); }
    .nav-links { display: flex; gap: 30px; color: var(--muted); font-size: 13px; font-weight: 700; }
    .nav-links a:hover { color: var(--cyan); }
    .nav-cta { border: 1px solid rgba(69,214,208,.5); color: var(--cyan); padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 800; }
    .hero { min-height: 650px; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 50px; padding: 82px 0 90px; position: relative; }
    .eyebrow { color: var(--cyan); font: 12px "DM Mono", monospace; letter-spacing: .13em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
    .eyebrow:before { content: ""; width: 28px; height: 1px; background: var(--cyan); }
    h1 { font-size: clamp(42px, 6vw, 70px); line-height: 1.08; letter-spacing: -.065em; margin: 22px 0; max-width: 690px; }
    h1 span { color: var(--cyan); }
    .intro { color: var(--muted); max-width: 550px; font-size: 16px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 13px; margin-top: 32px; }
    .btn { padding: 13px 19px; border-radius: 8px; font-size: 13px; font-weight: 800; display: inline-flex; align-items: center; gap: 10px; transition: .2s; }
    .btn-primary { background: var(--cyan); color: #06141d; }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(69,214,208,.2); }
    .btn-secondary { border: 1px solid var(--line); color: var(--text); }
    .btn-secondary:hover { border-color: var(--cyan); }
    .hero-meta { display: flex; gap: 28px; margin-top: 48px; color: var(--muted); font: 11px "DM Mono", monospace; text-transform: uppercase; letter-spacing: .06em; }
    .hero-meta strong { color: var(--text); display: block; font: 700 13px Manrope; margin-top: 5px; letter-spacing: 0; text-transform: none; }
    .visual { min-height: 390px; display: grid; place-items: center; position: relative; }
    .orbit { width: min(390px, 100%); aspect-ratio: 1; border: 1px solid rgba(91,156,255,.22); border-radius: 50%; position: relative; display: grid; place-items: center; background: radial-gradient(circle, rgba(69,214,208,.08), transparent 62%); }
    .orbit:before, .orbit:after { content: ""; position: absolute; border: 1px dashed rgba(69,214,208,.28); border-radius: 50%; inset: 11%; }
    .orbit:after { inset: 23%; border-style: solid; border-color: rgba(91,156,255,.25); }
    .core { width: 118px; height: 118px; border-radius: 28px; background: linear-gradient(145deg, #153b55, #0c2034); border: 1px solid rgba(69,214,208,.6); display: grid; place-items: center; box-shadow: 0 0 60px rgba(69,214,208,.17); z-index: 2; }
    .core svg { width: 55px; stroke: var(--cyan); }
    .node { position: absolute; z-index: 3; width: 54px; height: 54px; display: grid; place-items: center; border: 1px solid rgba(91,156,255,.45); background: #10243a; border-radius: 16px; color: var(--cyan); box-shadow: 0 8px 30px #050c16; }
    .node svg { width: 23px; stroke: currentColor; fill: none; stroke-width: 1.7; }
    .n1 { top: 5%; left: 43%; } .n2 { right: 4%; top: 42%; } .n3 { bottom: 7%; left: 43%; } .n4 { left: 4%; top: 42%; }
    .signal { position: absolute; bottom: 4%; right: -2%; font: 10px "DM Mono", monospace; color: var(--muted); background: var(--panel); border: 1px solid var(--line); padding: 12px 14px; border-radius: 8px; }
    .signal b { color: var(--cyan); font-weight: 500; }
    section { padding: 88px 0; border-top: 1px solid var(--line); }
    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin-bottom: 38px; }
    .section-kicker { color: var(--cyan); font: 11px "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
    h2 { margin: 8px 0 0; font-size: clamp(28px, 4vw, 42px); letter-spacing: -.05em; line-height: 1.2; }
    .section-note { max-width: 390px; color: var(--muted); font-size: 13px; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .card { background: linear-gradient(145deg, rgba(16,34,57,.9), rgba(13,26,43,.8)); border: 1px solid var(--line); border-radius: 14px; padding: 26px; }
    .card p { color: var(--muted); font-size: 14px; margin-bottom: 0; }
    .tag-row { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 22px; }
    .tag { border: 1px solid rgba(69,214,208,.22); color: #a9e8e5; background: rgba(69,214,208,.06); border-radius: 6px; padding: 7px 10px; font: 10px "DM Mono", monospace; }
    .skill-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .skill { padding: 22px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); }
    .skill-icon { color: var(--cyan); font: 22px "DM Mono", monospace; }
    .skill h3 { margin: 13px 0 7px; font-size: 15px; }
    .skill p { color: var(--muted); font-size: 12px; margin: 0; }
    .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .project { padding: 25px; background: var(--panel); border: 1px solid var(--line); border-radius: 13px; transition: .2s; }
    .project:hover { border-color: rgba(69,214,208,.5); transform: translateY(-3px); }
    .project-top { display: flex; justify-content: space-between; color: var(--cyan); font: 11px "DM Mono", monospace; }
    .project h3 { margin: 25px 0 8px; font-size: 19px; }
    .project p { color: var(--muted); font-size: 13px; }
    .project .tag-row { margin-top: 17px; }
    .learning { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .learning-item { display: flex; gap: 17px; padding: 19px 0; border-bottom: 1px solid var(--line); }
    .learning-item:last-child { border: 0; }
    .num { color: var(--cyan); font: 12px "DM Mono", monospace; padding-top: 4px; }
    .learning-item h3 { font-size: 14px; margin: 0 0 4px; }
    .learning-item p { color: var(--muted); font-size: 12px; margin: 0; }
    .contact-box { background: linear-gradient(120deg, #102b3d, #102039); border: 1px solid rgba(69,214,208,.25); border-radius: 18px; padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
    .contact-box p { color: var(--muted); max-width: 480px; font-size: 14px; }
    footer { padding: 27px 0; border-top: 1px solid var(--line); color: var(--muted); font: 10px "DM Mono", monospace; display: flex; justify-content: space-between; gap: 20px; }
    .mono { font-family: "DM Mono", monospace; }
    @media (max-width: 800px) {
      .nav-links { display: none; } .hero { grid-template-columns: 1fr; padding-top: 65px; gap: 25px; }
      .visual { min-height: 330px; } .orbit { width: 310px; }
      .about-grid, .learning { grid-template-columns: 1fr; } .skill-grid { grid-template-columns: repeat(2,1fr); }
      .section-head { display: block; } .section-note { margin-top: 15px; }
      .contact-box { padding: 30px; display: block; } .contact-box .btn { margin-top: 12px; }
    }
    @media (max-width: 520px) {
      .container { width: min(100% - 30px, 1120px); } nav { height: 66px; }
      .nav-cta { padding: 8px 11px; } .hero { min-height: auto; padding: 58px 0 65px; }
      h1 { font-size: 44px; } .hero-meta { gap: 17px; flex-wrap: wrap; }
      .skill-grid, .project-grid { grid-template-columns: 1fr; } section { padding: 65px 0; }
      .visual { min-height: 300px; } .orbit { width: 275px; } .node { width: 45px; height: 45px; }
      .signal { right: -1%; bottom: -2%; } footer { display: block; line-height: 2; }
    }
  </style>
</head>
